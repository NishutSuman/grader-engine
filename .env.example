# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Grading model providers ---
ANTHROPIC_API_KEY=                 # required — primary grader (Claude)
OPENROUTER_API_KEY=                # optional — cheap-model grading (Qwen/DeepSeek via OpenRouter)
QWEN_API_KEY=                      # optional
GLM_API_KEY=                       # optional
GEMINI_API_KEY=                    # optional
GOOGLE_API_KEY=                    # optional
MINIMAX_API_KEY=                   # optional

# --- Report card storage (S3) ---
GRADEPILOT_S3_BUCKET=              # required for S3 upload of report cards
GRADEPILOT_S3_REGION=us-east-1
GRADEPILOT_S3_PREFIX=gradepilot
GRADEPILOT_S3_PUBLIC=              # "true" to make uploaded objects public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Metabase (submission intake) ---
METABASE_URL=                      # e.g. https://metabase.masaischool.com
METABASE_SESSION=                  # session cookie value, NOT a durable API key —
                                    # log into Metabase yourself and grab your own,
                                    # do not just copy someone else's; it expires and
                                    # may not work from a different account/machine.

# --- GitHub (optional, raises API rate limit for cloned-repo submissions) ---
GITHUB_TOKEN=

# --- Google Drive downloads ---
# Uses a service-account key file, NOT an env var here. The code finds it by
# searching the repo for a file matching oauth-practice-*.json or sa_key.json
# (see grader/download.py:_sa_key_path). Place the key file anywhere under the
# repo, e.g. runs/<any-folder>/sa_key.json — it will be discovered automatically.
